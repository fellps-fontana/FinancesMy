{
  "name": "myfinances-mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP que expoe a API do MyFinances como tools (consulta, edicao e alertas de contas a pagar)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/httpServer.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/httpServer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
